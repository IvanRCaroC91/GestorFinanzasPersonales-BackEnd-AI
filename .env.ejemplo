# Plantilla de variables para el desarrollo local.
#
# Copia este archivo como ".env" y cambia cada "cambiar-esto" por una contraseña tuya.
# El archivo .env no se sube al repositorio. Este sí, por eso aquí NO va ninguna
# contraseña real.

# Administrador de PostgreSQL del contenedor local. Los servicios no lo usan.
POSTGRES_ADMIN_CONTRASENA=cambiar-esto

# Puerto de tu equipo por el que se llega al PostgreSQL del contenedor.
POSTGRES_PUERTO_LOCAL=5433

# --- Servicio de identidad ---
# Dirección de su base de datos. El puerto debe coincidir con POSTGRES_PUERTO_LOCAL.
IDENTIDAD_BD_URL=jdbc:postgresql://127.0.0.1:5433/identidad

# Usuario con el que trabaja el servicio. El nombre debe ser identidad_app, porque las
# migraciones le conceden los permisos por ese nombre.
IDENTIDAD_BD_USUARIO=identidad_app
IDENTIDAD_BD_CONTRASENA=cambiar-esto

# Usuario dueño de la base, con el que Flyway crea y cambia las tablas.
IDENTIDAD_BD_MIGRADOR_USUARIO=identidad_migrador
IDENTIDAD_BD_MIGRADOR_CONTRASENA=cambiar-esto

# Clave privada con la que se firman los tokens de acceso: ruta de un archivo PEM (PKCS#8)
# con una clave RSA de al menos 3072 bits, FUERA de la carpeta del repositorio. Se crea con:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out <ruta>/firma.pem
IDENTIDAD_CLAVE_FIRMA_RUTA=cambiar-esto

# Quién emite los tokens de acceso (dato "iss").
IDENTIDAD_TOKEN_EMISOR=http://localhost:8080

# Servidor de correo. En local, el Mailpit de compose.yaml: los correos se ven en
# http://localhost:8025. El puerto debe coincidir con MAILPIT_PUERTO_SMTP si lo cambias.
IDENTIDAD_SMTP_HOST=127.0.0.1
IDENTIDAD_SMTP_PUERTO=1025

# Dirección que aparece como remitente de los correos.
IDENTIDAD_CORREO_REMITENTE=no-responder@smartkash.local

# Dirección de la web (el frontend) a la que apuntan los enlaces de verificación. El enlace
# será <esta dirección>/verificar-correo#token=<valor>. Ajústala al puerto de tu frontend.
IDENTIDAD_ENLACE_BASE=http://localhost:5173

# --- Eureka (servidor de descubrimiento) ---
# Usuario y contraseña con los que los servicios se registran y consultan. Los lee el propio
# Eureka y todos los servicios que se registran en él. Sin valor por defecto: si faltan, no
# arrancan. En producción NO se escriben en un archivo del repositorio: los entrega la
# plataforma donde se despliega.
EUREKA_USUARIO=cambiar-esto
EUREKA_CONTRASENA=cambiar-esto


# --- Servicio de finanzas ---
# Dirección de su base de datos. El puerto debe coincidir con POSTGRES_PUERTO_LOCAL.
FINANZAS_BD_URL=jdbc:postgresql://127.0.0.1:5433/finanzas

# Usuario con el que trabaja el servicio. El nombre debe ser finanzas_app, porque las
# migraciones le conceden los permisos por ese nombre.
FINANZAS_BD_USUARIO=finanzas_app
FINANZAS_BD_CONTRASENA=cambiar-esto

# Usuario dueño de la base, con el que Flyway crea y cambia las tablas.
FINANZAS_BD_MIGRADOR_USUARIO=finanzas_migrador
FINANZAS_BD_MIGRADOR_CONTRASENA=cambiar-esto

# Dónde descarga las claves públicas para validar los tokens (las publica identidad) y quién
# debe figurar como emisor. El emisor debe ser igual a IDENTIDAD_TOKEN_EMISOR.
FINANZAS_JWKS_URI=http://localhost:8080/.well-known/jwks.json
FINANZAS_TOKEN_EMISOR=http://localhost:8080
