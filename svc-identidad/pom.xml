<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.smartkash</groupId>
        <artifactId>smartkash-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>svc-identidad</artifactId>
    <name>Servicio de identidad</name>
    <description>Usuarios, credenciales, tokens y roles</description>

    <dependencies>
        <dependency>
            <groupId>com.smartkash</groupId>
            <artifactId>nucleo-financiero</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.smartkash</groupId>
            <artifactId>nucleo-web</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Validacion de la forma de las solicitudes: campos obligatorios, formato de
             correo y largos, declarados con anotaciones sobre los campos. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Acceso a datos: JPA convierte filas en objetos, Hibernate lo implementa y
             Spring Data genera las consultas a partir de interfaces. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Migraciones: Flyway aplica los archivos SQL numerados al arrancar el servicio. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <!-- Modulo de Flyway que sabe hablar con PostgreSQL. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!-- Driver de PostgreSQL: solo hace falta al ejecutar, no al compilar. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Hash de contrasenas: solo la parte de Spring Security que calcula hashes,
             sin filtros web ni inicio de sesion. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!-- Libreria criptografica que implementa Argon2 por dentro. Spring Boot no fija
             su version, por eso se escribe aqui. -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.87</version>
        </dependency>

        <!-- Seguridad de las rutas: cadena de filtros de Spring Security y validacion del token
             de acceso (JWT) en cada peticion. Incluye Nimbus, que tambien se usa para firmar
             los tokens. Al anadirlo, toda ruta exige token salvo las declaradas publicas en
             la configuracion de seguridad. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Utilidades de prueba de Spring Security: aplicar la cadena de filtros real en las
             pruebas web y simular peticiones con y sin token. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Pruebas de integracion: un PostgreSQL real y desechable dentro de Docker. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.4.1</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>


</project>