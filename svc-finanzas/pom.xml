<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.smartkash</groupId>
        <artifactId>smartkash-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>svc-finanzas</artifactId>
    <name>Servicio de finanzas</name>
    <description>Cuentas, categorias y movimientos del usuario</description>

    <dependencies>
        <!-- Piezas compartidas con los demas servicios. -->
        <dependency>
            <groupId>com.smartkash</groupId>
            <artifactId>nucleo-financiero</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.smartkash</groupId>
            <artifactId>nucleo-web</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Servidor web y rutas HTTP. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Cliente de descubrimiento: al arrancar, el servicio se anota en Eureka con su
             nombre y su direccion, y el gateway lo encuentra por ese nombre. La version
             la fija la lista de Spring Cloud del pom raiz. -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>

        <!-- Acceso a datos: JPA convierte filas en objetos, Hibernate lo implementa y
             Spring Data genera las consultas a partir de interfaces. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Migraciones: Flyway aplica los archivos SQL numerados al arrancar el servicio. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <!-- Modulo de Flyway que sabe hablar con PostgreSQL. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!-- Driver de PostgreSQL: solo hace falta al ejecutar, no al compilar. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Pruebas de integracion: un PostgreSQL real y desechable dentro de Docker. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Reglas de arquitectura: ArchUnit lee las clases compiladas y comprueba que cada
             paquete solo depende de los que le corresponde. Solo se usa en las pruebas. -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.4.1</version>
            <scope>test</scope>
        </dependency>

        <!-- Utilidades para probar rutas protegidas con tokens simulados. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Seguridad: convierte el servicio en servidor de recursos. Lee el token de la cabecera
     Authorization, comprueba su firma y entrega sus datos al controlador. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>